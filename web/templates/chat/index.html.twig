{% extends 'base.html.twig' %}

{% block title %}Jin Chat{% endblock %}

{% block body %}
<div class="layout">
    <aside id="sidebar" class="sidebar" aria-label="Conversations enregistrées"
           data-conversations="{{ conversations|json_encode }}"
           data-folders="{{ folders|json_encode }}"
           data-create-url="{{ path('conversation_create') }}">
        <div class="sidebar-head">
            <h2>Conversations</h2>
            <button type="button" id="new-folder-button" class="ghost icon new-folder-button" title="Nouveau dossier" aria-label="Créer un dossier">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/><path d="M12 11v6M9 14h6"/></svg>
            </button>
            <button type="button" id="close-sidebar" class="ghost icon sidebar-close" title="Fermer" aria-label="Fermer la liste">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>
            </button>
        </div>
        <button type="button" id="save" class="save" disabled title="Enregistrer cette conversation (elle sera ensuite mise à jour automatiquement)">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><path d="M17 21v-8H7v8M7 3v5h8"/></svg>
            <span class="save-label">Enregistrer la conversation</span>
        </button>
        <ul id="conversations" class="conversations"></ul>
        <p id="no-conversation" class="muted sidebar-empty" hidden>Aucune conversation enregistrée.</p>
    </aside>
    <div id="backdrop" class="backdrop" hidden></div>

    <dialog id="move-dialog" class="dialog" aria-labelledby="move-heading">
        <form id="move-form" method="dialog">
            <h3 id="move-heading">Classer « <span id="move-title"></span> »</h3>
            <div id="move-folders" class="choices"></div>
            <label class="new-folder">
                <span>Nouveau dossier</span>
                <input id="new-folder" type="text" maxlength="50" placeholder="ex. Boulot, Code, Recettes…" autocomplete="off">
            </label>
            <div class="dialog-actions">
                <button type="button" id="move-cancel" class="ghost">Annuler</button>
                <button type="submit" value="create">Créer et ranger</button>
            </div>
        </form>
    </dialog>

    <div class="app" data-send-url="{{ path('chat_send') }}">
        <header class="topbar">
            <button type="button" id="open-sidebar" class="ghost icon menu" title="Conversations" aria-label="Afficher les conversations" aria-controls="sidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
            </button>
            <h1>Jin</h1>
            <label class="model">
                <span>Modèle</span>
                <select id="model" {{ models is empty ? 'disabled' }}>
                    {% for model in models %}
                        <option value="{{ model }}" {{ model == default_model ? 'selected' }}>{{ model }}</option>
                    {% endfor %}
                </select>
            </label>
            <div class="actions">
                <button type="button" id="reset" class="ghost" title="Nouvelle conversation" aria-label="Nouvelle conversation">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    <span class="label">Nouvelle conversation</span>
                </button>
                {% include '_theme_toggle.html.twig' %}
                <a href="{{ path('app_logout') }}" class="ghost button" title="Déconnexion ({{ app.user.userIdentifier }})" aria-label="Déconnexion">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                    <span class="label">Déconnexion</span>
                </a>
            </div>
        </header>

        <main id="messages" class="messages">
            {% if error %}
                <div class="notice error">Impossible de joindre l'API : {{ error }}</div>
            {% else %}
                <div class="notice" id="empty">Choisis un modèle et pose ta question.</div>
            {% endif %}
        </main>

        <form id="composer" class="composer">
            <textarea id="prompt" rows="1" placeholder="Pose ta question…" title="Entrée pour envoyer, Maj+Entrée pour aller à la ligne" {{ models is empty ? 'disabled' }}></textarea>
            <button type="submit" id="send" {{ models is empty ? 'disabled' }}>Envoyer</button>
        </form>
    </div>
</div>
{% endblock %}
